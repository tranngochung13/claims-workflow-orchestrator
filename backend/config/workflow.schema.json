{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "workflowId",
    "version",
    "initialState",
    "limits",
    "states",
    "transitions"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "workflowId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]{0,63}$"
    },
    "version": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "initialState": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]{0,63}$"
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "required": ["informationRequests"],
      "properties": {
        "informationRequests": {
          "type": "integer",
          "minimum": 1,
          "maximum": 3
        }
      }
    },
    "states": {
      "type": "array",
      "minItems": 1,
      "maxItems": 200,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "label", "terminal"],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]{0,63}$"
          },
          "label": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120,
            "pattern": "\\S"
          },
          "terminal": {
            "type": "boolean"
          }
        }
      }
    },
    "transitions": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "label",
          "from",
          "to",
          "roles",
          "inputFields",
          "preconditions",
          "sideEffects"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]{0,63}$"
          },
          "label": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120,
            "pattern": "\\S"
          },
          "from": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]{0,63}$"
          },
          "to": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]{0,63}$"
          },
          "roles": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "enum": ["claimant", "adjuster"]
            }
          },
          "kind": {
            "const": "information_request"
          },
          "inputFields": {
            "type": "array",
            "maxItems": 20,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "name",
                "label",
                "required",
                "minLength",
                "maxLength"
              ],
              "properties": {
                "name": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9_]{0,63}$"
                },
                "label": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 120,
                  "pattern": "\\S"
                },
                "required": {
                  "type": "boolean"
                },
                "minLength": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 2000
                },
                "maxLength": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 2000
                }
              }
            }
          },
          "preconditions": {
            "type": "array",
            "maxItems": 20,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["type", "fields"],
              "properties": {
                "type": {
                  "const": "claimFieldsPresent"
                },
                "fields": {
                  "type": "array",
                  "minItems": 1,
                  "uniqueItems": true,
                  "items": {
                    "enum": ["title", "description"]
                  }
                }
              }
            }
          },
          "sideEffects": {
            "type": "array",
            "maxItems": 20,
            "items": {
              "oneOf": [
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["type", "recipient", "template"],
                  "properties": {
                    "type": {
                      "const": "createNotification"
                    },
                    "recipient": {
                      "const": "claimant"
                    },
                    "template": {
                      "enum": [
                        "information_requested",
                        "claim_approved",
                        "claim_rejected"
                      ]
                    }
                  }
                },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["type"],
                  "properties": {
                    "type": {
                      "const": "recordPaymentInitiation"
                    }
                  }
                }
              ]
            }
          }
        }
      }
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#"
}
